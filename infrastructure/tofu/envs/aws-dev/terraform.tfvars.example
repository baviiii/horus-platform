project     = "horus"
environment = "dev"
region      = "ap-southeast-2"
owner       = "your-name"

# Budget alerts go here. Required.
alert_email = "you@example.com"

# Gross burn before credits (alerts at 50/80/100% + forecast) and real money
# after credits (alerts at $1).
monthly_usage_budget_usd = 50
out_of_pocket_budget_usd = 5

# Titan V2 width: 256 | 512 | 1024. Must match HORUS_VECTOR_DIMENSIONS.
vector_dimensions = 1024

# Browser origins for direct presigned uploads; leave empty for server-side only.
app_origins = []

create_app_access_key = true

# ── interview-coach-mcp on Lambda (mcp.tf) ──────────────────────────────────
# First apply: leave mcp_image_tag commented out. After CI has pushed an image,
# set it to that commit SHA and apply again.
# mcp_image_tag = "cf50c86"

mcp_cors_origin = "*"

mcp_settings = {
  HORUS_MODE    = "http"
  HORUS_TENANT  = "careercraft"
  HORUS_BASE_URL = "https://<careercraft-project>.supabase.co/functions/v1"
  SUPABASE_URL  = "https://<project>.supabase.co"
  MARKET        = "Australia"
  RESEARCH_MODE = "auto"
}

mcp_secrets = {
  SUPABASE_ANON_KEY = "..."
  HORUS_API_KEY     = "..."
  # Free from reddit.com/prefs/apps; without them Reddit drops out of research
  # on datacenter IPs.
  # REDDIT_CLIENT_ID     = "..."
  # REDDIT_CLIENT_SECRET = "..."
}
