
// Horus Platform — Production Prisma schema
// Multi-tenant by default. Every domain table carries tenantId.
// RLS policies are applied via migrations under prisma/migrations/.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, vector(map: "vector"), pg_trgm]
}

// =============================================================================
// Tenancy
// =============================================================================

enum Plan {
  FREE
  STARTER
  PRO
  SCALE
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  plan          Plan     @default(FREE)
  config        Json     @default("{}")
  customDomain  String?  @unique
  domainVerifiedAt DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members        TenantMember[]
  apiKeys        ApiKey[]
  documents      Document[]
  chunks         Chunk[]
  entities       Entity[]
  relationships  Relationship[]
  chatSessions   ChatSession[]
  prompts        Prompt[]
  usageRecords   UsageRecord[]
  auditLogs      AuditLog[]
  alerts         Alert[]
  webhooks       Webhook[]
  enabledModules TenantModule[]
  connections    Connection[]
  incidentTemplates IncidentTemplate[]
  incidents         Incident[]
  incidentEvidence  IncidentEvidence[]
  incidentEvents    IncidentEvent[]
  knowledgeCollections KnowledgeCollection[]
  agents           Agent[]
  automations      Automation[]

  @@index([slug])
  @@index([customDomain])
  @@map("tenants")
}

model TenantMember {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid // matches Supabase auth.users.id
  role      Role     @default(MEMBER)
  invitedBy String?  @db.Uuid
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  moduleKey String // careers, policy, generic, finance, legal...
  config    Json     @default("{}")
  enabledAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@map("tenant_modules")
}

// =============================================================================
// Auth: API Keys (for SDK consumers)
// =============================================================================

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  keyHash     String    @unique // bcrypt hash
  keyPrefix   String // public-displayable, e.g. "horus_sk_live_abc..."
  name        String
  scopes      String[]  @default([])
  rateLimit   Int       @default(100) // requests per minute
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]
  auditLogs    AuditLog[]

  @@index([tenantId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@map("api_keys")
}

// =============================================================================
// Documents & Search
// =============================================================================

enum DocStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
  ARCHIVED
}

model Document {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  collectionId String?   @db.Uuid
  title        String
  category     String?
  tags         String[]  @default([])
  blobUrl      String
  blobBytes    BigInt?
  mimeType     String?
  status       DocStatus @default(PENDING)
  pageCount    Int?
  chunksCount  Int       @default(0)
  searchIndex  String? // Azure AI Search index name
  metadata     Json      @default("{}")
  errorMessage String?
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  indexedAt    DateTime?

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection KnowledgeCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  chunks     Chunk[]
  entities   DocumentEntity[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([collectionId])
  @@map("documents")
}

model Chunk {
  id          String                       @id @default(uuid()) @db.Uuid
  tenantId    String                       @db.Uuid
  documentId  String                       @db.Uuid
  ordinal     Int
  text        String
  searchId    String? // ID in Azure AI Search
  embedding   Unsupported("vector(3072)")?
  pageNumber  Int?
  charStart   Int?
  charEnd     Int?
  metadata    Json                         @default("{}")
  createdAt   DateTime                     @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([tenantId, documentId])
  @@index([searchId])
  @@map("chunks")
}

// =============================================================================
// Knowledge Graph (mirror of Cosmos/Neo4j; canonical IDs live here)
// =============================================================================

model Entity {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  type        String // organization, program, policy, funding, skill, occupation, etc.
  graphNodeId String? // Cosmos vertex / Neo4j node ID
  aliases     String[] @default([])
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents  DocumentEntity[]
  outgoing   Relationship[]   @relation("FromEntity")
  incoming   Relationship[]   @relation("ToEntity")

  @@unique([tenantId, type, name])
  @@index([tenantId, type])
  @@index([graphNodeId])
  @@map("entities")
}

model Relationship {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  fromEntityId String   @db.Uuid
  toEntityId   String   @db.Uuid
  type         String // funds, employs, requires, located_in, contradicts, supports...
  confidence   Float    @default(1.0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromEntity Entity @relation("FromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("ToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromEntityId, toEntityId, type])
  @@index([tenantId, type])
  @@map("relationships")
}

model DocumentEntity {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  documentId String   @db.Uuid
  entityId   String   @db.Uuid
  mentions   Int      @default(1)
  pages      Int[]    @default([])
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityId])
  @@index([tenantId])
  // Entity → its documents: budget.allocations labels every candidate's
  // jurisdiction this way, and the (documentId, entityId) key can't serve it.
  @@index([entityId])
  @@map("document_entities")
}

// =============================================================================
// Chat / RAG sessions
// =============================================================================

enum MsgRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid // null = SDK-only caller
  apiKeyId  String?  @db.Uuid
  context   String? // career-coaching, policy-research, etc.
  title     String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  role       MsgRole
  content    String
  sources    Json? // citations
  toolCalls  Json?
  tokensIn   Int?
  tokensOut  Int?
  latencyMs  Int?
  modelUsed  String?
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// =============================================================================
// Prompts (per-tenant overrides + platform defaults)
// =============================================================================

model Prompt {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid // null = platform default
  key       String // career-coach, policy-analyst, etc.
  template  String
  variables Json     @default("{}") // schema for template variables
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, version])
  @@index([key, isActive])
  @@map("prompts")
}

// =============================================================================
// Usage / Billing
// =============================================================================

enum UsageMeter {
  RAG_QUERIES
  AGENTIC_QUERIES
  GRAPH_QUERIES
  EMBEDDINGS
  DOCUMENTS_PROCESSED
  COMPLETION_TOKENS_IN
  COMPLETION_TOKENS_OUT
  STORAGE_BYTES
}

model UsageRecord {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  apiKeyId   String?    @db.Uuid
  meter      UsageMeter
  quantity   BigInt
  unitCost   Decimal?   @db.Decimal(12, 6)
  metadata   Json       @default("{}")
  occurredAt DateTime   @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, meter, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("usage_records")
}

// =============================================================================
// Audit & Webhooks
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  apiKeyId   String?  @db.Uuid
  action     String
  resource   String?
  resourceId String?
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?
  occurredAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, action])
  @@map("audit_logs")
}

model Webhook {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  url        String
  events     String[]  @default([])
  secret     String
  isActive   Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhooks")
}

// =============================================================================
// Connections (tenant integrations: MCP tool servers, external APIs, ...)
// =============================================================================

enum ConnectionKind {
  MCP // Model Context Protocol tool server — Horus is the client
  API // generic HTTP integration (calendar, booking, CRM...)
}

enum ConnectionStatus {
  CONNECTED
  ERROR
  DISABLED
}

model Connection {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @db.Uuid
  kind     ConnectionKind
  // Namespace slug for tool names (mcp__<slug>__<tool>): [a-z0-9_].
  slug     String
  name     String
  endpoint String
  // none | bearer — the secret itself lives in secretRef, never here.
  authType String  @default("none")
  // Env var name holding the bearer secret (avoids secrets-at-rest in Postgres).
  secretRef String?
  config    Json             @default("{}")
  status    ConnectionStatus @default(CONNECTED)
  // Discovered tool cache: [{ name, description }].
  tools         Json      @default("[]")
  toolCount     Int       @default(0)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, kind])
  @@map("connections")
}

// =============================================================================
// Alerts (proactive intelligence notifications)
// =============================================================================

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Alert {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  kind        String // anomaly, contradiction, threshold, new_document, etc.
  severity    AlertSeverity @default(MEDIUM)
  status      AlertStatus   @default(OPEN)
  title       String
  description String
  context     Json          @default("{}")
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@map("alerts")
}

// =============================================================================
// Incident reporting (NDIS vertical — compliance-grade document generation)
//
// A tenant absorbs their own incident form into an IncidentTemplate (typed
// field schema), then each Incident is drafted by AI from evidence with
// per-field citations, reviewed and approved by a human, and exported as
// .docx (identified or de-identified). Horus never submits to a regulator.
// =============================================================================

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IncidentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EXPORTED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceKind {
  NARRATIVE // reporter's own account (the primary intake)
  PHOTO // image evidence, stored in blob + AI-analyzed to text
  DOCUMENT // uploaded file (shift notes, medical summary...), text-extracted
  NOTE // manual addendum typed during review
}

model IncidentTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  description String?
  status      TemplateStatus @default(DRAFT)
  version     Int            @default(1)
  // TemplateSchema JSON: { sections: [{key,title,description?}],
  //   fields: [{key,label,type,required,pii,section,options?,help?,conditional?}] }
  // Validated by @horus/core/incidents before every write.
  schema      Json
  // Provenance of the absorbed source form.
  sourceDocumentTitle String?
  sourceExcerpt       String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@index([tenantId, status])
  @@map("incident_templates")
}

model Incident {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  ref        String // human handle, e.g. INC-2026-0042
  templateId String?          @db.Uuid
  status     IncidentStatus   @default(DRAFT)
  severity   IncidentSeverity @default(MEDIUM)
  // Regulatory pack category key (e.g. ndis: death, serious_injury,
  // unauthorised_restrictive_practice...). Drives deadline computation.
  categoryKey String?
  title       String
  occurredAt   DateTime?
  // When key personnel became aware — the statutory clocks run from here.
  discoveredAt DateTime?
  location     String?
  summary      String?
  // IncidentFields JSON: { [fieldKey]: { value, confidence?, evidence?: [{evidenceId, quote}] } }
  // "manual" confidence marks human-entered values the AI must not overwrite.
  fields          Json     @default("{}")
  missingRequired String[] @default([])
  // Stable pseudonym map for de-identified exports: { "Jane Doe": "Participant A" }.
  // Persisted on first de-ID export so re-exports stay consistent.
  deidMap Json?
  // Statutory clocks (computed from categoryKey + discoveredAt; null = no category).
  notifyDueAt  DateTime?
  reportDueAt  DateTime?
  reportedById String    @db.Uuid
  approvedById String?   @db.Uuid
  approvedAt   DateTime?
  exportedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template IncidentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  evidence IncidentEvidence[]
  events   IncidentEvent[]

  @@unique([tenantId, ref])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, notifyDueAt])
  @@map("incidents")
}

model IncidentEvidence {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  incidentId String       @db.Uuid
  kind       EvidenceKind
  label      String // "Reporter narrative", filename, ...
  // Narrative text / extracted document text / AI photo analysis.
  text     String?
  blobUrl  String?
  mimeType String?
  bytes    Int?
  addedById String   @db.Uuid
  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([tenantId, incidentId])
  @@map("incident_evidence")
}

model IncidentEvent {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  incidentId String  @db.Uuid
  // created | drafted | field_updated | evidence_added | submitted | approved |
  // changes_requested | exported_identified | exported_deidentified | closed
  kind    String
  actorId String? @db.Uuid
  note    String?
  meta    Json    @default("{}")
  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([tenantId, incidentId, createdAt])
  @@map("incident_events")
}

// =============================================================================
// Customer portal — knowledge collections, agents, automations
//
// A tenant's self-serve surface. Collections group documents into named
// knowledge silos; Agents bind a collection (plus optional MCP connections)
// to a chat or voice persona; Automations are simple trigger → action rules
// over tenant data. All of it is tenant-scoped and RLS-enforced like the
// rest of the platform.
// =============================================================================

model KnowledgeCollection {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  slug        String // url-safe handle, unique per tenant
  description String?
  // Search partition this collection indexes into. Defaults to its slug.
  partition   String?
  // Optional source tagging: category filter applied when searching.
  category    String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("knowledge_collections")
}

enum AgentKind {
  CHAT // text chat inside the portal + embeddable widget
  VOICE // voice surface (WebRTC / PSTN) — config lives on configJson
  HYBRID // both
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Agent {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  name        String
  slug        String
  kind        AgentKind   @default(CHAT)
  status      AgentStatus @default(DRAFT)
  // System prompt / persona for the agent.
  persona     String?
  // Which collections ground this agent. Empty = whole tenant workspace.
  collectionIds String[]  @default([])
  // Which MCP connection slugs the agent may call.
  toolSlugs     String[]  @default([])
  // Voice config when kind=VOICE|HYBRID: { voice, language, providerRef, ... }.
  voiceConfig   Json      @default("{}")
  // UI / embed config: { greeting, theme, allowedOrigins, ... }.
  embedConfig   Json      @default("{}")
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("agents")
}

enum AutomationTrigger {
  DOCUMENT_INDEXED // a document finishes ingestion
  CHAT_SESSION_ENDED // a portal chat session closes
  SCHEDULE // cron-like schedule stored in config
  WEBHOOK // inbound webhook from an external system
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model Automation {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  name        String
  description String?
  trigger     AutomationTrigger
  status      AutomationStatus  @default(DRAFT)
  // Trigger-specific config: { cron, category, agentId, webhookSecretRef, ... }.
  triggerConfig Json @default("{}")
  // Action descriptor: { kind: 'webhook' | 'alert' | 'email' | 'infer', config: {...} }.
  action      Json
  lastRunAt   DateTime?
  lastError   String?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, trigger])
  @@map("automations")
}
