# =====================================================================
# Horus Platform — Environment Variables
# Copy this file to `.env.local` for local dev.
# In production, set these via Vercel / Azure Container Apps env config.
# =====================================================================

# ---------------------------------------------------------------------
# Core: App URLs & runtime
# ---------------------------------------------------------------------
NODE_ENV=development
# Public-facing apex domain(s). Comma-separated. Subdomains map to tenants.
HORUS_APEX_DOMAINS=horus.local:3000
# Used by SDK + server callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Database — Supabase Postgres
# `DATABASE_URL`     pooled (PgBouncer) — used at runtime
# `DIRECT_URL`       direct (5432)      — used by Prisma migrate
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# Supabase — Auth + Storage
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------
# Azure OpenAI — embeddings + chat
# ---------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://[resource].openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# ---------------------------------------------------------------------
# Azure AI Search — vector + hybrid retrieval
# ---------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://[service].search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=horus-rag

# ---------------------------------------------------------------------
# Azure Blob Storage — document originals + rendered images
# ---------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_DOCS=documents
AZURE_STORAGE_CONTAINER_RENDERED=rendered

# ---------------------------------------------------------------------
# Azure Cosmos DB (Gremlin) — knowledge graph
# ---------------------------------------------------------------------
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=horus
AZURE_COSMOS_GRAPH=knowledge

# ---------------------------------------------------------------------
# Azure Document Intelligence — PDF/chart extraction
# ---------------------------------------------------------------------
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# ---------------------------------------------------------------------
# Upstash Redis — rate limiting + idempotency
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------
# Stripe — billing + metered usage
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_SCALE=price_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ---------------------------------------------------------------------
# Resend — transactional email
# ---------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Horus <noreply@horus.ai>

# ---------------------------------------------------------------------
# Observability — Sentry + Axiom
# ---------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=horus-web
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

AXIOM_TOKEN=
AXIOM_DATASET=horus-prod
AXIOM_ORG_ID=

# ---------------------------------------------------------------------
# Worker / job queue — Azure Storage Queues
# ---------------------------------------------------------------------
AZURE_QUEUE_INGEST=ingest
AZURE_QUEUE_ALERTS=alerts
AZURE_QUEUE_SCRAPER=scraper

# ---------------------------------------------------------------------
# Optional: Local-only / debug
# ---------------------------------------------------------------------
# Bypass tenant resolver in dev — pretend every request is this slug
HORUS_DEV_TENANT_SLUG=
# Verbose tRPC logs
HORUS_DEBUG=0
